# ==============================================================================
# Weather & Market Data Ingestion Credentials and Configuration
# ==============================================================================

# Copernicus Climate Data Store (CDS) API (ERA5 Reanalysis)
# Register at: https://cds.climate.copernicus.eu/api-how-to
CDSAPI_URL=https://cds.climate.copernicus.eu/api/v2
CDSAPI_KEY=your_cds_api_key_here

# ENTSO-E Transparency Platform Token
# Register at: https://transparency.entsoe.eu/
ENTSOE_API_KEY=your_entsoe_api_token_here

# Open-Meteo API (Commercial key optional; public rate-limits apply if unset)
OPENMETEO_API_KEY=

# Renewables.ninja API Token
RENEWABLES_NINJA_TOKEN=

# Storage & Database Connections
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=power_market
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DUCKDB_PATH=data/processed/power_market.duckdb

# MLflow Tracking
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=european-wind-solar-forecasting

# Execution and Runtime Flags
LOG_LEVEL=INFO
USE_SYNTHETIC_DATA_FALLBACK=true
SEED=42
